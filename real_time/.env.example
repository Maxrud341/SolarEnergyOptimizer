# =====================================================================
# SolarEnergyOptimizer - Real-Time Environment Variables
# =====================================================================

# MQTT Broker (TUL Campus Broker)
# Standard unencrypted port 1883 (anonymous by default)
MQTT_BROKER_HOST=cassandra2.tul.cz
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_TX=FVE/Maly_TX
MQTT_TOPIC_RX=FVE/Maly_RX

# Geographical Coordinates (Liberec / TUL, Czech Republic)
# Used for Open-Meteo weather and solar irradiance forecasts
LOCATION_LATITUDE=50.767
LOCATION_LONGITUDE=15.056
LOCATION_TIMEZONE=Europe/Prague

# Optional External API Keys
# (NOTE: Spotovky.cz and Open-Meteo are 100% free and DO NOT require any keys)
ENTSOE_API_TOKEN=
OPENWEATHER_API_KEY=
